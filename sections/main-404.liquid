<style type="text/css">
  .template-404 .title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
  }
</style>

<div class="template-404 page-width page-margin center">
  <p class="kinrow-eyebrow">404 · Nothing to lift here</p>
  <h1 class="title">
    This page moved. Your routine hasn’t.
  </h1>
  <p>Try a search, head back to the collection, or ask us where something went.</p>
  <form action="{{ routes.search_url }}" method="get" role="search" class="kinrow-404-search">
    <label class="visually-hidden" for="Kinrow404Search">Search KINROW</label>
    <input id="Kinrow404Search" type="search" name="q" placeholder="Search products and guides">
    <button class="button" type="submit">Search</button>
  </form>
  <a href="{{ routes.all_products_collection_url }}" class="button">
    Shop all products
  </a>
</div>
{% style %}
  .template-404 { padding-block: clamp(7rem, 12vw, 15rem); }
  .template-404 .title { max-width: 12ch; margin-inline: auto; font-size: clamp(4.4rem, 8vw, 8rem); line-height: 1; }
  .template-404 > p { margin-inline: auto; }
  .kinrow-404-search { display: flex; gap: .8rem; max-width: 58rem; margin: 3rem auto 1.6rem; }
  .kinrow-404-search input { flex: 1; min-width: 0; padding: 1.2rem; border: 1px solid var(--kinrow-border); border-radius: var(--kinrow-radius-sm); font-size: 1.6rem; }
  @media(max-width: 549px){.kinrow-404-search{flex-direction:column}}
{% endstyle %}
