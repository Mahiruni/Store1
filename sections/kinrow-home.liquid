{{ 'section-kinrow-home.css' | asset_url | stylesheet_tag }}

<section class="kinrow-hero" aria-labelledby="kinrow-hero-title">
  <img src="{{ 'kinrow-hero.webp' | asset_url }}" alt="Compact charcoal home mobility equipment arranged on a pale oak floor" width="1599" height="900" loading="eager" fetchpriority="high">
  <div class="kinrow-hero__inner page-width">
    <div class="kinrow-hero__copy">
      <p class="kinrow-eyebrow">Considered movement, made compact</p>
      <h1 id="kinrow-hero-title">Strength that fits your life.</h1>
      <p>Quietly capable mobility tools for small spaces, busy days, and routines you can actually keep.</p>
      <div class="kinrow-actions">
        <a class="button" href="{{ routes.all_products_collection_url }}">Shop the collection</a>
        <a class="kinrow-text-link" href="#how-it-works">See how it works <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<div class="kinrow-trust-strip" aria-label="Store assurances">
  <div class="page-width">
    <span><strong>30 days</strong> to move with it</span>
    <span><strong>Free US shipping</strong> over $75</span>
    <span><strong>7–12 business days</strong> after dispatch</span>
    <span><strong>Secure checkout</strong> with major payment methods</span>
  </div>
</div>

<section class="kinrow-section page-width" aria-labelledby="best-sellers-title">
  <div class="kinrow-section__header">
    <div><p class="kinrow-eyebrow">Start where you are</p><h2 id="best-sellers-title">Our most useful essentials</h2></div>
    <a class="kinrow-text-link" href="{{ routes.all_products_collection_url }}">Shop all <span aria-hidden="true">→</span></a>
  </div>
  <div class="kinrow-product-grid">
    <a class="kinrow-product-card" href="/products/axis-resistance-kit">
      <img src="{{ 'kinrow-axis-kit.webp' | asset_url }}" width="1000" height="1000" loading="lazy" alt="Axis resistance kit components on a warm ivory background">
      <div><h3>Axis Resistance Kit</h3><p>Full-body strength, packed small.</p><span>$129</span></div>
    </a>
    <a class="kinrow-product-card" href="/products/form-fabric-loops">
      <img src="{{ 'kinrow-loop-set.webp' | asset_url }}" width="1000" height="1250" loading="lazy" alt="Three neutral fabric resistance loops and a cork mobility ball">
      <div><h3>Form Fabric Loops</h3><p>Three steady levels. Zero rolling.</p><span>$39</span></div>
    </a>
    <a class="kinrow-product-card kinrow-product-card--story" href="/products/anchor-ankle-weights">
      <div class="kinrow-product-card__shape" aria-hidden="true"></div>
      <div><h3>Anchor Ankle Weights</h3><p>Comfortable resistance for walks and mat work.</p><span>$59</span></div>
    </a>
  </div>
</section>

<section id="how-it-works" class="kinrow-section kinrow-section--surface" aria-labelledby="how-title">
  <div class="page-width">
    <div class="kinrow-section__header"><div><p class="kinrow-eyebrow">No performance theatre</p><h2 id="how-title">A simpler way to stay consistent</h2></div></div>
    <div class="kinrow-benefit-grid">
      <article><span aria-hidden="true">01</span><h3>Choose your resistance</h3><p>Start with the level that lets you move with control, then progress when the final repetitions feel steady.</p></article>
      <article><span aria-hidden="true">02</span><h3>Follow a short session</h3><p>Use the included quick-start guide to build a focused 15-minute strength or mobility block.</p></article>
      <article><span aria-hidden="true">03</span><h3>Pack it away</h3><p>Compact components store in a drawer or carry bag, so your space can return to being your space.</p></article>
    </div>
  </div>
</section>

<section class="kinrow-feature page-width" aria-labelledby="feature-title">
  <div class="kinrow-feature__media"><img src="{{ 'kinrow-lifestyle.webp' | asset_url }}" width="1000" height="1250" loading="lazy" alt="Woman using a resistance bar with controlled form in a bright apartment"></div>
  <div class="kinrow-feature__copy">
    <p class="kinrow-eyebrow">Meet Axis</p>
    <h2 id="feature-title">One kit. Dozens of controlled movements.</h2>
    <p>Axis pairs a segmented, grippy bar with clip-on woven bands so you can train presses, rows, hinges, squats, and mobility patterns without dedicating a room to equipment.</p>
    <ul class="kinrow-check-list">
      <li>Breaks down for easy storage and travel</li><li>Textured bands stay comfortable against skin</li><li>Quick-start guide keeps the first session simple</li><li>Replaceable components extend the kit’s useful life</li>
    </ul>
    <a class="button" href="/products/axis-resistance-kit">Explore the Axis Kit</a>
  </div>
</section>

<section class="kinrow-section kinrow-section--ink" aria-labelledby="compare-title">
  <div class="page-width">
    <p class="kinrow-eyebrow">Designed for the routine, not the reveal</p><h2 id="compare-title">The useful difference</h2>
    <div class="kinrow-comparison" role="region" aria-label="KINROW compared with a generic alternative" tabindex="0">
      <table>
        <thead><tr><th scope="col">What matters</th><th scope="col">KINROW</th><th scope="col">Generic alternative</th></tr></thead>
        <tbody>
          <tr><th scope="row">Product system</th><td>Compatible, replaceable components</td><td>Often sold as isolated pieces</td></tr>
          <tr><th scope="row">Visual clutter</th><td>Quiet, home-ready palette</td><td>Commonly bright and gym-coded</td></tr>
          <tr><th scope="row">Starting support</th><td>Plain-language quick-start guide</td><td>Varies by seller</td></tr>
          <tr><th scope="row">Delivery promise</th><td>Published before checkout</td><td>May be disclosed late</td></tr>
          <tr><th scope="row">Return window</th><td>30 days after delivery</td><td>Varies by marketplace</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="kinrow-section page-width" aria-labelledby="proof-title">
  <div class="kinrow-section__header"><div><p class="kinrow-eyebrow">Earned, never invented</p><h2 id="proof-title">Notes from verified customers</h2></div></div>
  {%- if section.blocks.size > 0 -%}
    <div class="kinrow-review-grid" role="list">
      {%- for block in section.blocks -%}
        <figure role="listitem" {{ block.shopify_attributes }}>
          <div aria-label="{{ block.settings.rating }} out of 5 stars">{%- for i in (1..block.settings.rating) -%}★{%- endfor -%}</div>
          <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
          <figcaption><strong>{{ block.settings.name | escape }}</strong> · Verified purchase</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="kinrow-empty-proof"><p>We’re new. Real purchase reviews—and only real purchase reviews—will appear here after customers have had time to use their gear.</p><a class="kinrow-text-link" href="/pages/our-story">Why we publish this way <span aria-hidden="true">→</span></a></div>
  {%- endif -%}
</section>

<section class="kinrow-community page-width" aria-labelledby="community-title">
  <div class="kinrow-community__copy"><p class="kinrow-eyebrow">Your space. Your pace.</p><h2 id="community-title">Made to live where you do.</h2><p>Customer photos will join this wall only with permission. Until then, these are KINROW campaign images—not simulated UGC.</p></div>
  <div class="kinrow-community__images"><img src="{{ 'kinrow-axis-kit.webp' | asset_url }}" width="1000" height="1000" loading="lazy" alt="KINROW campaign image of the Axis resistance kit"><img src="{{ 'kinrow-loop-set.webp' | asset_url }}" width="1000" height="1250" loading="lazy" alt="KINROW campaign image of neutral fabric loops"></div>
</section>

<section class="kinrow-section kinrow-section--surface" aria-labelledby="faq-title">
  <div class="page-width kinrow-faq-layout">
    <div><p class="kinrow-eyebrow">Good questions, clear answers</p><h2 id="faq-title">Before you begin</h2><p>Still unsure? Email <a href="mailto:care@kinrow.co">care@kinrow.co</a>. We answer within one business day.</p></div>
    <div class="kinrow-faq">
      <details><summary>Is this suitable for beginners?</summary><p>Yes. Every resistance product includes a starting level and a plain-language guide. Choose controlled form over maximum tension, and ask a qualified professional if you are returning after injury.</p></details>
      <details><summary>When will my order arrive?</summary><p>Allow 1–2 business days for processing, then 7–12 business days for standard US delivery. Your cart and confirmation email show the same estimate before you pay.</p></details>
      <details><summary>Can I return an opened product?</summary><p>Yes. Try it carefully at home. You can request a return within 30 days of delivery, including for opened products, provided all components are returned and there is no damage beyond normal trial use.</p></details>
      <details><summary>Do fabric bands roll or pinch?</summary><p>The wider woven construction is designed to sit flatter than thin latex loops. Fit and movement still matter, so start without clothing seams underneath the band and adjust placement if it shifts.</p></details>
      <details><summary>How much space do I need?</summary><p>For most movements, allow enough room to lie on a mat with your arms extended. The Axis Kit itself packs down to fit a shelf, drawer, or suitcase.</p></details>
      <details><summary>Are results guaranteed?</summary><p>No product can guarantee fitness outcomes. KINROW tools make consistent resistance work easier to fit into your day; results depend on use, progression, recovery, and individual circumstances.</p></details>
    </div>
  </div>
</section>

<section class="kinrow-newsletter page-width" aria-labelledby="newsletter-title">
  <div><p class="kinrow-eyebrow">A useful welcome</p><h2 id="newsletter-title">Get the 15-minute reset.</h2><p>Join for a printable mobility session and 10% off your first order. One welcome series, then useful notes—never daily noise.</p></div>
  {%- form 'customer', class: 'kinrow-newsletter__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter"><label for="KinrowEmail">Email address</label>
    <div><input id="KinrowEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="you@example.com"><button class="button" type="submit">Send my reset</button></div>
    {%- if form.posted_successfully? -%}<p role="status">Check your inbox—your reset is on its way.</p>{%- endif -%}{%- if form.errors -%}<div role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <small>By subscribing, you agree to receive KINROW emails. Unsubscribe in one click.</small>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "KINROW home",
  "tag": "div",
  "class": "kinrow-home",
  "settings": [],
  "blocks": [{
    "type": "verified_review", "name": "Verified review",
    "settings": [
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "textarea", "id": "quote", "label": "Review text" },
      { "type": "text", "id": "name", "label": "Customer first name and last initial" }
    ]
  }],
  "presets": [{ "name": "KINROW home" }]
}
{% endschema %}
